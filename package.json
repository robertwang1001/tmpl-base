{
  "name": "tmpl-base",
  "type": "module",
  "version": "1.1.0",
  "packageManager": "pnpm@11.5.1",
  "description": "",
  "author": {
    "name": "Robert Wang",
    "email": "glorywong1001@gmail.com"
  },
  "index": "./dist/index.js",
  "license": "MIT",
  "homepage": "https://github.com/robertwang1001/tmpl-base#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/robertwang1001/tmpl-base.git"
  },
  "bugs": "https://github.com/robertwang1001/tmpl-base/issues",
  "keywords": [],
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rimraf dist && tsc",
    "prepare": "pnpm simple-git-hooks",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "renovate-check": "renovate-config-validator --no-global",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.0",
    "@vitest/coverage-istanbul": "4.1.8",
    "eslint": "^10.4.1",
    "happy-dom": "^20.10.1",
    "lint-staged": "^17.0.7",
    "renovate": "^43.212.4",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.22.4",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm test",
    "commit-msg": "pnpm commitlint --edit ${1}"
  },
  "lint-staged": {
    "*": "pnpm lint:fix"
  }
}
